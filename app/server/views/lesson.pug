extends layout2

block content
    table
        tr
            td(width='600',align='left')
    #wrapper.ui-widget-content.ui-corner-all
        p
            #welcome_i18n(align='center',style='font-family:Century,Lucida Sans Unicode,sans-serif;font-size:4.4em;line-height:1.1em;color:#47FFFC;')!= __('welcome_i18n')
        #lectures_i18n.subtitle!= __('lectures_i18n')
        - if(cls.lecCode!="New") {
            div(align="center",style="font-size:4.5em;color:#0B3382;line-height:1.3em;")
                span #{cls.title}
                span (#{cls.lecCode})
            - if(typeof canEdit !== 'undefined' && canEdit) {
                div(align='center',style='margin:14px 0;')
                    a.btn.btn-success(href='/' + owner + '/lecture/' + cls.lecCode)!= __('edit_lecture_i18n')
            - }
            p
            table#ltable(border='0',cellspacing='0',cellpadding='0',width='100%')
                                    tbody
                                        tr
                                            td.leftside2
                                                p
                                                    h2
                                                        font(color='#0B3382')
                                                            span#objective_i18n!= __('objective_i18n')
                                                div(style='line-height:2em;')
                                                    img(border='0',width='15',height='15',src='img/redtri.gif')
                                                    span(style='font-size:12pt;') #{cls.objective}
                                                p
                                                    h2
                                                        font(color='#0B3382')
                                                            span#textbooks_i18n!= __('textbooks_i18n')
                                                div(style='line-height:2em;')
                                                    img(border='0',width='15',height='15',src='img/redtri.gif')
                                                    span(style='font-size:12pt;') #{cls.textbook}
                                                p
                                                    h2
                                                        font(color='#0B3382')
                                                            span#references_i18n!= __('references_i18n')
                                                div(style='line-height:2em;')
                                                    img(border='0',width='15',height='15',src='img/redtri.gif')
                                                    span(style='font-size:12pt;') #{cls.reference}
                                                p
                                                    h2
                                                        font(color='#0B3382')
                                                            span#advreferences_i18n!= __('advreferences_i18n')
                                                div(style='line-height:2em;')
                                                    img(border='0',width='15',height='15',src='img/redtri.gif')
                                                    span(style='font-size:12pt;') #{cls.advreference}
                                            td(valign='top',style='padding-right:0pt;padding-top:0pt')
                                                table(border='0',cellspacing='4',cellpadding='0',width='40',style='width:100.0%;')
                                                    tbody
                                                        - var ii=0;
                                                        - cls.group.forEach(function(h) {
                                                            tr
                                                                td.righttitle2 #{h.name}
                                                                    - h.classes.forEach(function(f) {
                                                                        tr
                                                                            td.rightcontents2
                                                                                img(border='0',width='10',height='10',src='img/redtri.gif')
                                                                                - var l=cnts[ii++];
                                                                                - if(l.name=='None') {
                                                                                    a(href=(canEdit ? ('/'+owner+'/citem/'+l.cntCode) : ('/citem?p='+l.cntCode))) #{l.cntCode}
                                                                                - } else if(l.sign==0 && l.url) {
                                                                                    a(href=l.url,target='_blank') #{l.name}
                                                                                - } else {
                                                                                    a(href=(canEdit ? ('/'+owner+'/citem/'+l.cntCode) : ('/citem?p='+l.cntCode))) #{l.name}
                                                                                - }
                                                                    - });
                                                        - });
        - } else {
            div(align='center',style='font-size:4.5em;color:#0B3382;line-height:1.3em;')  #{cls.title}
                textarea#Code(name='Code',height='12',cols='30') #{cls.lecCode}
                div.subtitle#week_i18n!= __('week_i18n')
        - }
        hr
        div(align='right')
            table
                tr
                    td
                        #author_name_i18n(style='font-size:2em;color:#0B3382;')!= __('author_name_i18n')
                    td
                        span(style='font-size:2em;color:#0B3382;') #{cls.author}
                    td
                        span(style='font-size:2em;color:#0B3382;') [#{cls.lang}]
        hr
        p
            div(align='center') Last update: Mon Nov 26 21:01:16 PST 2012 by
                span(style='vertical-align:3pt;')
                    img(src="img/logo231.gif",width="87",height="27",alt="yass@hosei.ac.jp")
                            
    include modals/alert
    include modals/lost-password

block scripts
    script(src='/vendor/jquery/jquery-1.8.1.min.js')
    script(src='/vendor/jquery/jquery.i18n.properties-1.0.9.js')
    script(src='/vendor/jquery.form.js')
    script(src='/vendor/bootstrap-modal.js')
    script(src='/vendor/bootstrap-transition.js')
    script(src='/js/views/login.js')
    script(src='/js/controllers/loginController.js')
    script(src='/js/controllers/homeController.js')
    script(src='/js/form-validators/loginValidator.js')
    script(src='/js/form-validators/emailValidator.js')
