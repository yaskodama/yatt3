extends layout2

//- Top-right of the shared topbar. Logged-in visitors get the normal nav;
//- guests get the language picker + sign-up link + sign-in popover.
block topbar-right
    if currentUser
        .yatt-nav
            a(href='/' + currentUser.user + '/home')!= __('nav_home')
            a(href='/' + currentUser.user + '/edit')!= __('nav_edit')
            a(href='/' + currentUser.user + '/top')!= __('nav_public')
            if currentUser.user === 'root'
                a.yatt-admin(href='/root/users')!= __('nav_users')
    else
        .yatt-auth
            a.yatt-auth-up(href='/signup')
                span#create-account!= __('create_account_i18n')
            details.auth-pop
                summary.auth-trigger
                    span#signin_i18n!= __('signin_i18n')
                    span.auth-caret ▾
                .auth-panel
                    #login-container2
                        form(method="post", action="/")#login-form
                            label
                                span#username_i18n!= __('username_i18n')
                            input(type="text", name="user", id='user-tf').required
                            label
                                span#password_i18n!= __('password_i18n')
                            input(type="password", name="pass", id='pass-tf').required
                            button(type="submit")#btn-login.btn.btn-primary
                                span#signin_name_i18n!= __('signin_name_i18n')
                            label#remember-me.checkbox
                                input(type="checkbox", checked='checked')
                                |  Remember Me
                            div.btm-links
                                a(href='#')#forgot-password Forgot Your Password?

block content
    .tt-hero
        .hero-eyebrow
            span.pulse
            span!= __('timetable_i18n')
        h1#welcome_i18n.login-title!= __('welcome_i18n')
        if owner
            p#tt-tagline.login-tagline(data-suffix=__('owners_timetable'))!= '@' + owner + __('owners_timetable')
        else
            p#tt-tagline.login-tagline(data-suffix=__('owners_timetable'))!= __('tagline_default')

    if users && users.length
        .user-gallery
            .user-gallery-head!= __('public_pages_i18n')
            .user-gallery-grid
                each u in users
                    a.user-card(href='/' + u.user + '/top', class=(owner === u.user ? 'is-current' : ''))
                        .user-avatar= (u.name || u.user).charAt(0).toUpperCase()
                        .user-card-name= u.user
                        if u.name && u.name !== u.user
                            .user-card-full= u.name

    #wrapper.ui-widget-content.ui-corner-all
        #timetable_i18n.subtitle!= __('timetable_i18n')
        #timetable-mount
            include timetable
        .tt-foot Last update: Mon Nov 26 21:01:16 PST 2012 — yass@hosei.ac.jp

    include modals/alert
    include modals/lost-password

block scripts
    script(src='/vendor/jquery/jquery-1.8.1.min.js')
    script(src='/vendor/jquery/jquery.i18n.properties-1.0.9.js')
    script(src='/vendor/jquery.form.js')
    script(src='/vendor/bootstrap-modal.js')
    script(src='/vendor/bootstrap-transition.js')
    script(src='/js/views/login.js')
    script(src='/js/controllers/loginController.js')
    script(src='/js/controllers/homeController.js')
    script(src='/js/form-validators/loginValidator.js')
    script(src='/js/form-validators/emailValidator.js')
