doctype html
html(lang=(lang || 'ja'))
	head
		meta(charset='UTF-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		title= title
		link(rel='preconnect', href='https://fonts.googleapis.com')
		link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
		link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&family=Klee+One:wght@600&display=swap')
		link(rel='stylesheet', href='/vendor/bootstrap.min.css')
		link(rel='stylesheet', href='/css/style.css')
		link(rel='stylesheet', href='/stylesheets/style.css')
		link(rel='stylesheet', href='/css/theme.css')
		block scripts
	body
		.yatt-grid
		nav.yatt-topbar
			a.yatt-brand(href='/')
				span.yatt-dot
				span.grad-text YaTT
			.yatt-spacer
			.yatt-langtoggle
				a(href='/lang/ja', class=(lang === 'ja' ? 'is-on' : '')) JA
				a(href='/lang/en', class=(lang === 'en' ? 'is-on' : '')) EN
			block topbar-right
				.yatt-nav
					if currentUser
						a(href='/' + currentUser.user + '/home')!= __('nav_home')
						a(href='/' + currentUser.user + '/edit')!= __('nav_edit')
						a(href='/' + currentUser.user + '/top')!= __('nav_public')
					else
						a(href='/')!= __('nav_home')
		//- Left admin menu (root only). Designed to grow to several items.
		if currentUser && currentUser.user === 'root'
			nav.yatt-sidebar
				.yatt-sidebar-title!= __('um_admin')
				a.yatt-sidebar-item(href='/root/users', class=(currentPath === '/root/users' ? 'is-active' : ''))
					span.yatt-sidebar-ic
						svg(viewBox='0 0 24 24', width='18', height='18', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round')
							path(d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2')
							circle(cx='9', cy='7', r='4')
							path(d='M23 21v-2a4 4 0 0 0-3-3.87')
							path(d='M16 3.13a4 4 0 0 1 0 7.75')
					span.yatt-sidebar-label!= __('nav_users')
		block content
