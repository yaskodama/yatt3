doctype html
html(lang=(lang || 'ja'))
	head
		meta(charset='UTF-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		title= title
		link(rel='preconnect', href='https://fonts.googleapis.com')
		link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
		link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&family=Klee+One:wght@600&display=swap')
		link(rel='stylesheet', href='/vendor/bootstrap.min.css')
		link(rel='stylesheet', href='/css/style.css')
		link(rel='stylesheet', href='/stylesheets/style.css')
		link(rel='stylesheet', href='/css/theme.css')
		block scripts
	body
		.yatt-grid
		nav.yatt-topbar
			a.yatt-brand(href='/')
				span.yatt-dot
				span.grad-text YaTT
			.yatt-spacer
			.yatt-langtoggle
				a(href='/lang/ja', class=(lang === 'ja' ? 'is-on' : '')) JA
				a(href='/lang/en', class=(lang === 'en' ? 'is-on' : '')) EN
			block topbar-right
				.yatt-nav
					if currentUser
						a(href='/' + currentUser.user + '/home')!= __('nav_home')
						a(href='/' + currentUser.user + '/edit')!= __('nav_edit')
						a(href='/' + currentUser.user + '/top')!= __('nav_public')
						if currentUser.user === 'root'
							a.yatt-admin(href='/root/users')!= __('nav_users')
					else
						a(href='/')!= __('nav_home')
		block content
